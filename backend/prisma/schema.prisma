generator client {

  provider = "prisma-client-js"

}



datasource db {

  provider = "postgresql"

  url      = env("DATABASE_URL")

}



enum TipoCampo {

  INTEIRO

  DECIMAL

  TEXTO

  LOGICO

  DATA

  LISTA

}



enum PerfilTipoUsuario {

  ADMINISTRADOR

  SISTEMA

  COMUM

}



enum UrbanoRural {

  URBANO

  RURAL

}

enum EstadoCivilVoluntario {
  CASADO
  DIVORCIADO
  SEPARADO
  SOLTEIRO
  VIUVO
}

enum PeriodoInscricao {
  MANHA
  TARDE
  NOITE
}

enum SituacaoTurma {
  ABERTA
  FECHADA
}

enum DiaSemana {
  DOMINGO
  SEGUNDA_FEIRA
  TERCA_FEIRA
  QUARTA_FEIRA
  QUINTA_FEIRA
  SEXTA_FEIRA
  SABADO
}

enum OcupacaoFamiliar {
  NAO_TRABALHA
  CONTA_PROPRIA
  TEMPORARIO_RURAL
  EMPREGADO_SEM_CARTEIRA
  EMPREGADO_COM_CARTEIRA
  DOMESTICO_SEM_CARTEIRA
  DOMESTICO_COM_CARTEIRA
  NAO_REMUNERADO
  MILITAR_SERVIDOR_PUBLICO
  EMPREGADOR
  ESTAGIARIO
  APRENDIZ
}

enum TipoDeficienciaFamiliar {
  CEGUEIRA
  BAIXA_VISAO
  SURDEZ_LEVE_MODERADA
  DEFICIENCIA_FISICA
  DEFICIENCIA_MENTAL_INTELECTUAL
  SINDROME_DOWN
  TRANSTORNO_MENTAL
}

enum RespostaSimNao {
  SIM
  NAO
}

enum FormaAcessoInstituicao {
  DEMANDA_ESPONTANEA
  BUSCA_ATIVA
  ENCAMINHAMENTO_ASSISTENCIA_SOCIAL
  ENCAMINHAMENTO_SAUDE
  ENCAMINHAMENTO_EDUCACAO
  ENCAMINHAMENTO_CONSELHO_TUTELAR
  ENCAMINHAMENTO_GARANTIA_DIREITOS
  OUTROS
}

enum UfBrasil {

  AC

  AL

  AP

  AM

  BA

  CE

  DF

  ES

  GO

  MA

  MT

  MS

  MG

  PA

  PB

  PR

  PE

  PI

  RJ

  RN

  RS

  RO

  RR

  SC

  SP

  SE

  TO

}



model TipoFormulario {

  id                  String    @id @default(uuid()) @db.Uuid

  nome                String

  descricao           String?

  ativo               Boolean   @default(true)

  usuarioInclusaoId   String?   @map("usuario_inclusao_id") @db.Uuid

  dataHoraInclusao    DateTime  @default(now()) @map("data_hora_inclusao") @db.Timestamptz(3)

  usuarioAlteracaoId  String?   @map("usuario_alteracao_id") @db.Uuid

  dataHoraAlteracao   DateTime? @map("data_hora_alteracao") @db.Timestamptz(3)



  perguntas  Pergunta[]

  submissoes Submissao[]

  tiposUsuario TipoUsuarioTipoFormulario[]

  usuarios     UsuarioTipoFormulario[]



  @@map("tipos_formulario")

}



model Pergunta {

  id                  String    @id @default(uuid()) @db.Uuid

  enunciado           String

  tipoCampo           TipoCampo @map("tipo_campo")

  tamanhoCampo        Int?      @map("tamanho_campo")

  linhasCampo         Int?      @map("linhas_campo")

  tipoFormularioId    String    @map("tipo_formulario_id") @db.Uuid

  ordem               Int       @default(0)

  ativo               Boolean   @default(true)

  usuarioInclusaoId   String?   @map("usuario_inclusao_id") @db.Uuid

  dataHoraInclusao    DateTime  @default(now()) @map("data_hora_inclusao") @db.Timestamptz(3)

  usuarioAlteracaoId  String?   @map("usuario_alteracao_id") @db.Uuid

  dataHoraAlteracao   DateTime? @map("data_hora_alteracao") @db.Timestamptz(3)



  tipoFormulario TipoFormulario @relation(fields: [tipoFormularioId], references: [id], onDelete: Restrict)

  opcoes         PerguntaOpcao[]

  respostas      Resposta[]



  @@unique([tipoFormularioId, ordem])

  @@map("perguntas")

}



model PerguntaOpcao {

  id                  String    @id @default(uuid()) @db.Uuid

  perguntaId          String    @map("pergunta_id") @db.Uuid

  rotulo              String

  ordem               Int       @default(0)

  ativo               Boolean   @default(true)

  usuarioInclusaoId   String?   @map("usuario_inclusao_id") @db.Uuid

  dataHoraInclusao    DateTime  @default(now()) @map("data_hora_inclusao") @db.Timestamptz(3)

  usuarioAlteracaoId  String?   @map("usuario_alteracao_id") @db.Uuid

  dataHoraAlteracao   DateTime? @map("data_hora_alteracao") @db.Timestamptz(3)



  pergunta  Pergunta   @relation(fields: [perguntaId], references: [id], onDelete: Restrict)

  respostas Resposta[]



  @@map("pergunta_opcoes")

}



model Cidade {

  id                  String    @id @default(uuid()) @db.Uuid

  codigo              Int       @unique

  nomeMunicipio       String    @map("nome_municipio")

  estado              UfBrasil

  ativo               Boolean   @default(true)

  usuarioInclusaoId   String?   @map("usuario_inclusao_id") @db.Uuid

  dataHoraInclusao    DateTime  @default(now()) @map("data_hora_inclusao") @db.Timestamptz(3)

  usuarioAlteracaoId  String?   @map("usuario_alteracao_id") @db.Uuid

  dataHoraAlteracao   DateTime? @map("data_hora_alteracao") @db.Timestamptz(3)

  usuarioExclusaoId   String?   @map("usuario_exclusao_id") @db.Uuid

  dataHoraExclusao    DateTime? @map("data_hora_exclusao") @db.Timestamptz(3)



  pessoas Pessoa[]
  voluntarios Voluntario[]
  alunosNaturalidade Aluno[] @relation("AlunoNaturalidade")
  alunosEndereco Aluno[] @relation("AlunoEnderecoCidade")

  @@unique([nomeMunicipio, estado])

  @@map("cidades")

}



model Bairro {

  id                  String    @id @default(uuid()) @db.Uuid

  codigo              Int       @unique

  nome                String

  ativo               Boolean   @default(true)

  usuarioInclusaoId   String?   @map("usuario_inclusao_id") @db.Uuid

  dataHoraInclusao    DateTime  @default(now()) @map("data_hora_inclusao") @db.Timestamptz(3)

  usuarioAlteracaoId  String?   @map("usuario_alteracao_id") @db.Uuid

  dataHoraAlteracao   DateTime? @map("data_hora_alteracao") @db.Timestamptz(3)

  usuarioExclusaoId   String?   @map("usuario_exclusao_id") @db.Uuid

  dataHoraExclusao    DateTime? @map("data_hora_exclusao") @db.Timestamptz(3)

  pessoas Pessoa[]

  @@map("bairros")

}

model Escolaridade {
  id                  String    @id @default(uuid()) @db.Uuid
  codigo              Int       @unique
  descricao           String
  ativo               Boolean   @default(true)
  usuarioInclusaoId   String?   @map("usuario_inclusao_id") @db.Uuid
  dataHoraInclusao    DateTime  @default(now()) @map("data_hora_inclusao") @db.Timestamptz(3)
  usuarioAlteracaoId  String?   @map("usuario_alteracao_id") @db.Uuid
  dataHoraAlteracao   DateTime? @map("data_hora_alteracao") @db.Timestamptz(3)
  usuarioExclusaoId   String?   @map("usuario_exclusao_id") @db.Uuid
  dataHoraExclusao    DateTime? @map("data_hora_exclusao") @db.Timestamptz(3)

  condicoesEducacionais EntrevistaCondicaoEducacional[]
  alunos Aluno[]

  @@map("escolaridades")
}

model Departamento {
  id                  String    @id @default(uuid()) @db.Uuid
  codigo              Int       @unique
  descricao           String
  ativo               Boolean   @default(true)
  usuarioInclusaoId   String?   @map("usuario_inclusao_id") @db.Uuid
  dataHoraInclusao    DateTime  @default(now()) @map("data_hora_inclusao") @db.Timestamptz(3)
  usuarioAlteracaoId  String?   @map("usuario_alteracao_id") @db.Uuid
  dataHoraAlteracao   DateTime? @map("data_hora_alteracao") @db.Timestamptz(3)

  voluntarioHorarios VoluntarioDepartamentoHorario[]

  @@map("departamentos")
}

model Curso {
  id                  String    @id @default(uuid()) @db.Uuid
  codigo              Int       @unique
  descricao           String
  ativo               Boolean   @default(true)
  usuarioInclusaoId   String?   @map("usuario_inclusao_id") @db.Uuid
  dataHoraInclusao    DateTime  @default(now()) @map("data_hora_inclusao") @db.Timestamptz(3)
  usuarioAlteracaoId  String?   @map("usuario_alteracao_id") @db.Uuid
  dataHoraAlteracao   DateTime? @map("data_hora_alteracao") @db.Timestamptz(3)

  turmas Turma[]

  @@map("cursos")
}

model Turma {
  id                 String           @id @default(uuid()) @db.Uuid
  codigo             Int              @unique
  nome               String
  cursoCodigo        Int              @map("curso_codigo")
  periodo            PeriodoInscricao
  situacao           SituacaoTurma    @default(ABERTA)
  ativo              Boolean          @default(true)
  usuarioInclusaoId  String?          @map("usuario_inclusao_id") @db.Uuid
  dataHoraInclusao   DateTime         @default(now()) @map("data_hora_inclusao") @db.Timestamptz(3)
  usuarioAlteracaoId String?          @map("usuario_alteracao_id") @db.Uuid
  dataHoraAlteracao  DateTime?        @map("data_hora_alteracao") @db.Timestamptz(3)

  curso      Curso                 @relation(fields: [cursoCodigo], references: [codigo], onDelete: Restrict)
  inscricoes InscricaoAlunoCurso[]

  @@map("turmas")
}

model Aluno {
  id                 String                 @id @default(uuid()) @db.Uuid
  nome               String
  nomeSocial         String?                @map("nome_social")
  estadoCivil        EstadoCivilVoluntario? @map("estado_civil")
  rg                 String?
  orgaoExpedidor     String?                @map("orgao_expedidor")
  dtExpedicaoRg      DateTime?              @map("dt_expedicao_rg") @db.Date
  cpf                String?                @unique
  dtNascimento       DateTime?              @map("dt_nascimento") @db.Date
  nacionalidade      String?
  naturalidadeCodigo Int?                   @map("naturalidade_codigo")
  nomeMae            String?                @map("nome_mae")
  nomePai            String?                @map("nome_pai")
  escolaridadeCodigo Int?                   @map("escolaridade_codigo")
  nomeUltimaEscola   String?                @map("nome_ultima_escola")
  endereco           String?
  enderecoNumero     String?                @map("endereco_numero")
  bairro             String?
  cep                String?
  cidadeCodigo       Int?                   @map("cidade_codigo")
  telefone           String?
  celular            String?
  telefoneRecado     String?                @map("telefone_recado")
  email              String?
  ativo              Boolean                @default(true)
  usuarioInclusaoId  String?                @map("usuario_inclusao_id") @db.Uuid
  dataHoraInclusao   DateTime               @default(now()) @map("data_hora_inclusao") @db.Timestamptz(3)
  usuarioAlteracaoId String?                @map("usuario_alteracao_id") @db.Uuid
  dataHoraAlteracao  DateTime?              @map("data_hora_alteracao") @db.Timestamptz(3)

  naturalidade Cidade?       @relation("AlunoNaturalidade", fields: [naturalidadeCodigo], references: [codigo], onDelete: Restrict)
  cidade       Cidade?       @relation("AlunoEnderecoCidade", fields: [cidadeCodigo], references: [codigo], onDelete: Restrict)
  escolaridade Escolaridade? @relation(fields: [escolaridadeCodigo], references: [codigo], onDelete: Restrict)
  inscricoes   InscricaoAlunoCurso[]

  @@map("alunos")
}

model InscricaoAlunoCurso {
  id                        String           @id @default(uuid()) @db.Uuid
  codigo                    Int              @unique
  alunoId                   String           @map("aluno_id") @db.Uuid
  turmaCodigo               Int              @map("turma_codigo")
  dtCurso                   DateTime         @map("dt_curso") @db.Date
  jaFezCursoSenacSenai      Boolean          @default(false) @map("ja_fez_curso_senac_senai")
  cursoSenacSenaiDescricao  String?          @map("curso_senac_senai_descricao")
  possuiEncaminhamento      Boolean          @default(false) @map("possui_encaminhamento")
  orgaoEncaminhamento       String?          @map("orgao_encaminhamento")
  telefoneEncaminhamento    String?          @map("telefone_encaminhamento")
  possuiNecessidadeEspecial Boolean          @default(false) @map("possui_necessidade_especial")
  qualNecessidade           String?          @map("qual_necessidade")
  fazAcompanhamentoMedico   Boolean          @default(false) @map("faz_acompanhamento_medico")
  tomaMedicacao             Boolean          @default(false) @map("toma_medicacao")
  quaisMedicacoes           String?          @map("quais_medicacoes")
  vacinacao                 String?
  alergias                  String?
  matriculado               Boolean          @default(false)
  dtInicioCurso             DateTime?        @map("dt_inicio_curso") @db.Date
  usuarioMatriculaId        String?          @map("usuario_matricula_id") @db.Uuid
  dataHoraMatricula         DateTime?        @map("data_hora_matricula") @db.Timestamptz(3)
  matriculaCancelada        Boolean          @default(false) @map("matricula_cancelada")
  usuarioCancelamentoMatriculaId String?     @map("usuario_cancelamento_matricula_id") @db.Uuid
  dataHoraCancelamentoMatricula DateTime?    @map("data_hora_cancelamento_matricula") @db.Timestamptz(3)
  ativo                     Boolean          @default(true)
  usuarioInclusaoId         String?          @map("usuario_inclusao_id") @db.Uuid
  dataHoraInclusao          DateTime         @default(now()) @map("data_hora_inclusao") @db.Timestamptz(3)
  usuarioAlteracaoId        String?          @map("usuario_alteracao_id") @db.Uuid
  dataHoraAlteracao         DateTime?        @map("data_hora_alteracao") @db.Timestamptz(3)

  aluno        Aluno                    @relation(fields: [alunoId], references: [id], onDelete: Restrict)
  turma        Turma                    @relation(fields: [turmaCodigo], references: [codigo], onDelete: Restrict)
  rendaFamiliar InscricaoRendaFamiliar[]
  atendimentos InscricaoAtendimento[]

  @@map("inscricoes_aluno_curso")
}

model InscricaoAtendimento {
  id                 String   @id @default(uuid()) @db.Uuid
  inscricaoId        String   @map("inscricao_id") @db.Uuid
  dataAtendimento    DateTime @map("data_atendimento") @db.Date
  descricao          String   @db.VarChar(2000)
  usuarioInclusaoId  String?  @map("usuario_inclusao_id") @db.Uuid
  dataHoraInclusao   DateTime @default(now()) @map("data_hora_inclusao") @db.Timestamptz(3)
  usuarioAlteracaoId String?  @map("usuario_alteracao_id") @db.Uuid
  dataHoraAlteracao  DateTime? @map("data_hora_alteracao") @db.Timestamptz(3)

  inscricao InscricaoAlunoCurso @relation(fields: [inscricaoId], references: [id], onDelete: Restrict)

  @@index([inscricaoId])
  @@map("inscricao_atendimentos")
}

model InscricaoRendaFamiliar {
  id                 String   @id @default(uuid()) @db.Uuid
  inscricaoId        String   @map("inscricao_id") @db.Uuid
  ordem              Int      @default(0)
  nome               String
  idade              Int?
  renda              Decimal  @default(0) @db.Decimal(12, 2)
  parentesco         String?
  profissao          String?
  usuarioInclusaoId  String?  @map("usuario_inclusao_id") @db.Uuid
  dataHoraInclusao   DateTime @default(now()) @map("data_hora_inclusao") @db.Timestamptz(3)
  usuarioAlteracaoId String?  @map("usuario_alteracao_id") @db.Uuid
  dataHoraAlteracao  DateTime? @map("data_hora_alteracao") @db.Timestamptz(3)

  inscricao InscricaoAlunoCurso @relation(fields: [inscricaoId], references: [id], onDelete: Restrict)

  @@map("inscricao_renda_familiar")
}

model Voluntario {
  id                    String                  @id @default(uuid()) @db.Uuid
  codigo                Int                     @unique
  empresa               String?
  funcao                String?                 @map("funcao")
  estadoCivil           EstadoCivilVoluntario?  @map("estado_civil")
  dtNascimento          DateTime?               @map("dt_nascimento") @db.Date
  endereco              String?
  enderecoNumero        String?                 @map("endereco_numero")
  bairro                String?
  cep                   String?
  cidadeCodigo          Int?                    @map("cidade_codigo")
  enderecoComplemento   String?                 @map("endereco_complemento")
  rg                    String?
  cpf                   String?                 @unique
  cnh                   String?
  celular               String?
  telefoneResidencial   String?                 @map("telefone_residencial")
  telefoneComercial     String?                 @map("telefone_comercial")
  email                 String?
  valorContribuicao     Decimal?                @map("valor_contribuicao") @db.Decimal(12, 2)
  diaVencimento         Int?                    @map("dia_vencimento")
  tempoTrabalhoCentro   Int?                    @map("tempo_trabalho_centro")
  nome                  String
  nomeCracha            String                  @map("nome_cracha")
  fichaMedica           String?                 @map("ficha_medica") @db.VarChar(1000)
  ativo                 Boolean                 @default(true)
  usuarioInclusaoId     String?                 @map("usuario_inclusao_id") @db.Uuid
  dataHoraInclusao      DateTime                @default(now()) @map("data_hora_inclusao") @db.Timestamptz(3)
  usuarioAlteracaoId    String?                 @map("usuario_alteracao_id") @db.Uuid
  dataHoraAlteracao     DateTime?               @map("data_hora_alteracao") @db.Timestamptz(3)

  cidade             Cidade?                         @relation(fields: [cidadeCodigo], references: [codigo], onDelete: Restrict)
  departamentoHorarios VoluntarioDepartamentoHorario[]

  @@map("voluntarios")
}

model VoluntarioDepartamentoHorario {
  id                  String    @id @default(uuid()) @db.Uuid
  voluntarioId        String    @map("voluntario_id") @db.Uuid
  departamentoCodigo  Int       @map("departamento_codigo")
  diaSemana           DiaSemana @map("dia_semana")
  horaInicio          DateTime  @map("hora_inicio") @db.Time(0)
  horaTermino         DateTime  @map("hora_termino") @db.Time(0)
  usuarioInclusaoId   String?   @map("usuario_inclusao_id") @db.Uuid
  dataHoraInclusao    DateTime  @default(now()) @map("data_hora_inclusao") @db.Timestamptz(3)
  usuarioAlteracaoId  String?   @map("usuario_alteracao_id") @db.Uuid
  dataHoraAlteracao   DateTime? @map("data_hora_alteracao") @db.Timestamptz(3)

  voluntario   Voluntario   @relation(fields: [voluntarioId], references: [id], onDelete: Restrict)
  departamento Departamento @relation(fields: [departamentoCodigo], references: [codigo], onDelete: Restrict)

  @@map("voluntario_departamento_horarios")
}

model Pessoa {

  id                  String    @id @default(uuid()) @db.Uuid

  nome                String

  nomeSocial          String?   @map("nome_social")

  nomeMae             String?   @map("nome_mae")

  nomePai             String?   @map("nome_pai")

  dtNascimento        DateTime  @map("dt_nascimento") @db.Date

  cpf                 String    @unique

  rg                  String

  rgOrgaoEmissao      String?   @map("rg_orgao_emissao")

  nis                 String?

  endereco            String?

  enderecoNumero      String?   @map("endereco_numero")

  enderecoComplemento String?   @map("endereco_complemento")

  bairroCodigo        Int?      @map("bairro_codigo")

  cidadeCodigo        Int?      @map("cidade_codigo")

  telefone            String?

  telefone2           String?   @map("telefone_2")

  urbanoRural         UrbanoRural? @map("urbano_rural")

  ativo               Boolean   @default(true)

  usuarioInclusaoId   String?   @map("usuario_inclusao_id") @db.Uuid

  dataHoraInclusao    DateTime  @default(now()) @map("data_hora_inclusao") @db.Timestamptz(3)

  usuarioAlteracaoId  String?   @map("usuario_alteracao_id") @db.Uuid

  dataHoraAlteracao   DateTime? @map("data_hora_alteracao") @db.Timestamptz(3)



  bairro     Bairro?  @relation(fields: [bairroCodigo], references: [codigo], onDelete: Restrict)

  cidade     Cidade?  @relation(fields: [cidadeCodigo], references: [codigo], onDelete: Restrict)

  submissoes           Submissao[]
  entrevistasAssistido EntrevistaAssistido[]

  @@map("pessoas")

}

model EntrevistaAssistido {
  id                  String    @id @default(uuid()) @db.Uuid
  pessoaId            String    @map("pessoa_id") @db.Uuid
  dataEntrevista                 DateTime        @map("data_entrevista") @db.Date
  outrosTexto                    String?         @map("outros_texto") @db.VarChar(500)
  remediosControladosMental      RespostaSimNao? @map("remedios_controlados_mental")
  remediosControladosQuais       String?         @map("remedios_controlados_quais") @db.VarChar(500)
  usoAbusivoAlcool               RespostaSimNao? @map("uso_abusivo_alcool")
  usoAbusivoDrogas               RespostaSimNao? @map("uso_abusivo_drogas")
  usoAbusivoDrogasQuais          String?         @map("uso_abusivo_drogas_quais") @db.VarChar(500)
  temGestante                    RespostaSimNao? @map("tem_gestante")
  bolsaFamilia                   Boolean         @default(false) @map("bolsa_familia")
  peti                           Boolean         @default(false)
  bpc                            Boolean         @default(false)
  outrosProgramas                Boolean         @default(false) @map("outros_programas")
  outrosProgramasSociais         String?         @map("outros_programas_sociais") @db.VarChar(30)
  cras                           Boolean         @default(false)
  centroPop                      Boolean         @default(false) @map("centro_pop")
  conselhoTutelar                Boolean         @default(false) @map("conselho_tutelar")
  ubs                            Boolean         @default(false)
  creas                          Boolean         @default(false)
  caps                           Boolean         @default(false)
  craf                           Boolean         @default(false)
  outrosAtendimentoFamilia       Boolean         @default(false) @map("outros_atendimento_familia")
  outrosOrgaosSociais            String?         @map("outros_orgaos_sociais") @db.VarChar(30)
  usuarioInclusaoId   String?   @map("usuario_inclusao_id") @db.Uuid
  dataHoraInclusao    DateTime  @default(now()) @map("data_hora_inclusao") @db.Timestamptz(3)
  usuarioAlteracaoId  String?   @map("usuario_alteracao_id") @db.Uuid
  dataHoraAlteracao   DateTime? @map("data_hora_alteracao") @db.Timestamptz(3)

  pessoa            Pessoa                            @relation(fields: [pessoaId], references: [id], onDelete: Restrict)
  formasAcesso      EntrevistaAssistidoFormaAcesso[]
  composicaoFamiliar     EntrevistaComposicaoFamiliar[]
  condicoesTrabalho      EntrevistaCondicaoTrabalho[]
  condicoesEducacionais  EntrevistaCondicaoEducacional[]
  deficienciasFamilia    EntrevistaDeficienciaFamiliar[]
  gestantesFamilia       EntrevistaGestanteFamiliar[]

  @@map("entrevistas_assistido")
}

