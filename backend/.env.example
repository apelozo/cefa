# Local (docker compose) ou Neon/cloud:
# Neon (pooler): inclua pgbouncer=true para evitar erro "cached plan must not change result type" após migrations
# Produção (Render): https://cefa-api.onrender.com — ver docs/deploy-render.md
DATABASE_URL="postgresql://user:password@host/db?sslmode=require&pgbouncer=true"
PORT=3000
JWT_SECRET="altere-em-producao"
ADMIN_INITIAL_PASSWORD="admin123"
